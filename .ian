# -*- coding: utf-8; mode: shell-script; tab-width: 4 -*-

function ian-release-hook-DISABLED() {
    local version=$(upstream-version)
    sc-assert-files-exist commodity/version.py
    echo "__version__ = '$version'" > commodity/version.py

    hg tag "$version"

    version-summary
}

function ian-clean-hook {
    rm -rf MANIFEST
    rm -rf dist
}	
