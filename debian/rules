#!/usr/bin/make -f

export PYBUILD_NAME=go2
export DH_ALWAYS_EXCLUDE=__pycache__

VERSION=$(shell head -n 1 debian/changelog | cut -f2 -d " " | tr -d "()" | cut -f1 -d "-")
APP=go2
ORIG_REPO=git@bitbucket.org:DavidVilla/go2.git
ORIG_DIR=$(APP)-$(VERSION)
EXCLUDE=--exclude=debian --exclude=\*~ --exclude=.hg --exclude=.svn --exclude=\*.pyc

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	dh_auto_build
	rst2man go2.rst > go2.1

override_dh_auto_clean:
	dh_auto_clean
	-$(RM) go2.1

get-orig-source:
	git clone $(ORIG_REPO) --branch $(VERSION) --single-branch $(ORIG_DIR)
	tar $(EXCLUDE) -czf $(APP)_$(VERSION).orig.tar.gz $(ORIG_DIR)
	$(RM) -r $(ORIG_DIR)
