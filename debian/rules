#!/usr/bin/make -f

DEB_PYTHON_SYSTEM=pycentral
DBK2MAN_XSL=/usr/share/xml/docbook/stylesheet/nwalsh/manpages/docbook.xsl

include /usr/share/cdbs/1/rules/debhelper.mk
include /usr/share/cdbs/1/class/python-distutils.mk

build/go2::
	xsltproc --nonet $(DBK2MAN_XSL) debian/go2.xml
#	#/usr/bin/docbook-to-man debian/go2.sgml > go2.1

install/go2::
	mv $(CURDIR)/debian/go2/usr/bin/go2.py $(CURDIR)/debian/go2/usr/bin/go2cmd

clean::
	-rm go2.1
