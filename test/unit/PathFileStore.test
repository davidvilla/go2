#!/usr/bin/atheist
# -*- mode:python; coding:utf-8 -*-

import sys
sys.path.append('$basedir')

import os
import unittest2 as unittest
import time

import fs
from fs.memoryfs import MemoryFS

from pyDoubles.framework import *

import go2
from go2 import PathFileStore, from_file_provider, PathItem

HOME = '/home/user'

class StubFS(object):
    def setUp(self):
        self.fs = MemoryFS()
        self.mkdir('lab')

        config = go2.get_config([])
        config.fs = self.fs
        go2.config = config

    def mkdir(self, relpath):
        self.fs.makedir(fs.join(HOME, relpath), recursive=True)

    def PathFileStore_with_content(self, fpath, more=''):
        self.fs.createfile(fpath, u'''\
1: /home/user/lab
2: /home/user/lab/media
''' + more)
        return PathFileStore(fpath)


class Test_PathFileStore(unittest.TestCase, StubFS):
    def setUp(self):
        StubFS.setUp(self)

    def test_load_ok(self):
        sut = self.PathFileStore_with_content(fpath='paths')
        self.assertEquals(set(sut.data.keys()),
                          set([u'/home/user/lab',
                               u'/home/user/lab/media']))

    def test_load_missing(self):
        sut = PathFileStore('missing')
        self.assertEquals(sut.data, {})

    def assert_visits(self, store_path, path, visits):
        self.assertIn("{0}:{1}\n".format(visits, path),
                      self.fs.getcontents(store_path))

    def store_create_and_insert(self, store_path, path, size=None, visits=None):
        sut = self.PathFileStore_with_content(store_path)
        sut.insert_and_save(path)
        if size:
            self.assertEquals(len(sut.data), size)
        if visits:
            self.assert_visits(store_path, path, visits)
        return sut

    def test_insert_new(self):
#        self.store_create_and_insert('paths', u'/home/user/new', 3, 1)
        self.store_create_and_insert('paths', u'/XXX', 3, 1)

    def test_insert_old_most_visited(self):
        path = u'/home/user/lab/media'
        sut = self.store_create_and_insert('paths', path, 2, 3)
        self.assertEquals(list(sut)[0], path)

    def test_insert_old_less_visited(self):
        path = u'/home/user/lab'
        store = 'paths'
        sut = self.store_create_and_insert(store, path, 2, 2)
        sut.insert_and_save(path)
        self.assert_visits(store, path, 3)
        self.assertEquals(list(sut)[0], path)


class Test_from_file_provider(unittest.TestCase, StubFS):
    def setUp(self):
        StubFS.setUp(self)

    def test_search_existing(self):
        sut = self.PathFileStore_with_content('paths')
        go2.config.pattern = ['la']

        paths = list(from_file_provider(sut))

        self.assertIn(PathItem(u'/home/user/lab'), paths)

    def test_search_missing(self):
        "from_file_provider remove checked missing paths"
        sut = self.PathFileStore_with_content('paths')
        go2.config.pattern = ['med']

        paths = list(from_file_provider(sut))

        self.assertFalse(paths)

UnitTestCase()
