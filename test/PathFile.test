#!/usr/bin/atheist
# -*- mode:python; coding:utf-8 -*-

import sys
sys.path.append('$basedir')

import os
import unittest2 as unittest
import time

import fs
from mock import Mock

mnt = '/tmp/mnt'
mfs = MockFS(mnt)

import go2
from go2 import PathStore, file_task


def remove_all():
    for i in mfs.fs.listdir():
        if mfs.fs.isfile(i):
            mfs.fs.remove(i)
        else:
            mfs.fs.removedir(i, force=True, recursive=True)

def PathStore_with_sample_content(fname, more=''):
    mfs.fs.createfile(fname, '''\
/tmp/mnt/user/lab
/tmp/mnt/user/lab/media
''' + more)
    return PathStore(os.path.join(mnt, fname))

def insert_and_assert(testcase, pfile, path):
    pfile.insert(path)
    pfile.save()
    testcase.assertEquals(pfile.data[0], path)
    testcase.assertEquals(mfs.fs.getcontents(
            fs.split(pfile.path)[1]).split()[0], path)

class Test_PathStore(unittest.TestCase):
    def setUp(self):
        remove_all()
        self.assertEquals(mfs.fs.listdir(), [])
        mfs.fs.makedir('/user/lab', recursive=True)

    def test_load_ok(self):
        sut = PathStore_with_sample_content('paths')
        self.assertEquals(sut.data,
                          ['/tmp/mnt/user/lab',
                           '/tmp/mnt/user/lab/media'])

    def test_insert_new(self):
        sut = PathStore_with_sample_content('paths')
        insert_and_assert(self, sut, '/tmp/mnt/user/new')
        self.assertEquals(len(sut.data), 3)

    def test_insert_old(self):
        sut = PathStore_with_sample_content('paths')
        insert_and_assert(self, sut, '/tmp/mnt/user/lab/media')
        self.assertEquals(len(sut.data), 2)


class Test_file_task(unittest.TestCase):
    def setUp(self):
        remove_all()
        self.assertEquals(mfs.fs.listdir(), [])
        mfs.fs.makedir('/user/lab', recursive=True)

    def test_search_existing(self):
        sut = PathStore_with_sample_content('paths')
        go2.config = go2.parse_args(['la'])

        result = []
        queue = Mock()
        queue.put = result.append
        file_task(queue, sut, True)
        self.assertEquals(result, ['/tmp/mnt/user/lab'])

    def test_search_missing(self):
        "file_task remove checked missing paths"
        sut = PathStore_with_sample_content('paths')
        go2.config = go2.parse_args(['med'])

        result = []
        queue = Mock()
        queue.put = result.append
        file_task(queue, sut, update=True)
        self.assertEquals(result, [])

        self.assertEquals(mfs.fs.getcontents('/paths').strip(),
                          '/tmp/mnt/user/lab')


UnitTestCase()
